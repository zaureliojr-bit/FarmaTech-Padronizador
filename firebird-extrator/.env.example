# Copie este arquivo pra ".env" (mesma pasta) e preencha com os dados
# reais - o ".env" nunca deve ir pro Git (já está no .gitignore).

# Caminho completo do arquivo do banco (termina em .FDB, o nome do
# arquivo em si - não só a pasta). Use barra normal "/" mesmo no
# Windows, ou barra dupla "\\".
FB_DATABASE=C:/Farmax/NOMEDOBANCO.FDB

# Servidor Firebird local (qualquer versão - 2.5, 3, 4 ou 5, o
# node-firebird negocia a criptografia da conexão sozinho)
FB_HOST=localhost
FB_PORT=3050

# Credenciais do Firebird - padrão costuma ser SYSDBA/masterkey, mas
# pode ter sido trocado pelo Farmax.
FB_USER=SYSDBA
FB_PASSWORD=masterkey

# Número da filial (ver tabela FILIAIS) - decide quais colunas
# ESTOQUE_N / PRECO_VENDA_N são lidas.
FB_FILIAL=0

# Onde salvar a planilha gerada.
SAIDA_ARQUIVO=produtos_extraidos.xlsx

# Opcional: manda o arquivo gerado direto pro worker que hospeda as
# imagens (rotas /extracao* do imagens-proxy) - o painel do site então
# avisa sozinho que tem uma extração nova esperando um clique em
# "Importar agora", sem precisar arrastar o arquivo manualmente.
# Deixa em branco pra pular essa parte (o arquivo local continua sendo
# gerado normalmente do mesmo jeito).
UPLOAD_URL=
UPLOAD_KEY=
