# Copie este arquivo pra ".env" (mesma pasta) e preencha com os dados
# reais - o ".env" nunca deve ir pro Git (já está no .gitignore).

# Caminho do arquivo do banco no seu PC (a cópia local, não o servidor
# de produção da farmácia). Use barra normal "/" mesmo no Windows, ou
# barra dupla "\\".
FB_DATABASE=C:/Users/HOME-PC/OneDrive/Desktop/TESTE CONEXAO SITE/ITAFARMAX/ITAFARMAX.FDB

# Servidor Firebird local (o que você instalou, versão 2.5.9)
FB_HOST=localhost
FB_PORT=3050

# Credenciais do Firebird - padrão costuma ser SYSDBA/masterkey, mas
# pode ter sido trocado pelo Farmax.
FB_USER=SYSDBA
FB_PASSWORD=masterkey

# Número da filial (ver tabela FILIAIS) - decide quais colunas
# ESTOQUE_N / PRECO_VENDA_N são lidas. Pra "Drogaria Rápida de
# Oliveira" é 3.
FB_FILIAL=3

# Onde salvar a planilha gerada.
SAIDA_ARQUIVO=produtos_extraidos.xlsx
