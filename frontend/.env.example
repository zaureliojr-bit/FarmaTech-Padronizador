# URL do proxy da Cosmos API (Cloudflare Worker) usado para buscar a
# imagem oficial do produto pelo EAN. A Cosmos não libera chamada
# direta do navegador (CORS), então passamos por esse proxy - o token
# da Cosmos fica guardado nele, nunca aqui no frontend.
# Veja cosmos-proxy/README.md pra criar o worker.
VITE_COSMOS_PROXY_URL=

# URL do proxy da Serper (Cloudflare Worker) usado como segunda
# tentativa de busca de imagem, por texto (marca + descrição), quando a
# Cosmos não encontra o EAN ou a cota diária dela acabou.
# Veja serper-proxy/README.md pra criar o worker.
VITE_SERPER_PROXY_URL=

# Copie este arquivo para .env e preencha com a URL dos seus workers.
# Sem Cosmos nem Serper configurados, o app pula direto para a busca
# manual.
#
# Observação: a Google Custom Search JSON API e o Bing Search API não
# entraram aqui de propósito - o Google fechou a Custom Search JSON API
# para novos clientes (desliga de vez em 01/01/2027) e a Bing Search API
# está migrando de plataforma, sem instância nova disponível no modelo
# antigo. Nenhuma das duas vale a pena integrar do zero hoje.

# URL do worker que publica o catálogo direto no site "Drogaria Mais
# Barato" (sobrescreve produtos.json no repositório GitHub Produtos).
# Veja publish-proxy/README.md pra criar o worker e o token do GitHub.
VITE_PUBLISH_WORKER_URL=


# URL do worker que hospeda de verdade as imagens dos produtos (R2 +
# D1) - baixa a imagem uma vez (Cosmos/Serper/manual) e guarda o
# arquivo, indexado por EAN. Sem isso configurado, imagem escolhida no
# modal não tem como ser salva. Veja imagens-proxy/README.md.
VITE_IMAGENS_PROXY_URL=


# URL do produtos.json publicado no site - usado só pela migração
# única de imagens antigas (botão "Migrar imagens antigas"), pra saber
# quais links de imagem já existentes ainda precisam ser hospedados no
# R2. Mesmo arquivo que o script.js do site lê.
VITE_PRODUTOS_JSON_URL=https://raw.githubusercontent.com/zaureliojr-bit/Produtos/refs/heads/main/produtos.json

# URL do pedidos-proxy, que agora é o PORTEIRO do catálogo: toda escrita
# (salvar imagem, salvar correção, publicar no site) passa por ele, com
# a senha do painel.
#
# As chaves VITE_IMAGENS_KEY e VITE_PUBLISH_KEY saíram daqui de
# propósito e NÃO devem voltar: o Vite embute toda variável VITE_ no
# pacote em tempo de build, então elas ficavam legíveis em texto no
# JavaScript que qualquer um baixa - e com a de publicação se reescreve
# o catálogo inteiro do site. Agora elas são secret do pedidos-proxy, no
# servidor, e o navegador nunca as vê.
VITE_PEDIDOS_PROXY_URL=

# Origens que podem mandar a senha do painel para o padronizador por
# postMessage (o painel roda o padronizador num quadro). Separadas por
# vírgula. Só precisa mexer se o painel mudar de endereço.
VITE_ORIGENS_PAINEL=https://drogaria-site.pages.dev
