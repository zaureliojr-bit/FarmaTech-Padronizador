# Token da Cosmos API (https://cosmos.bluesoft.com.br) usado para buscar
# a imagem oficial do produto pelo EAN.
VITE_COSMOS_TOKEN=

# Google Custom Search API (busca de imagens na web) - até 4 opções por
# produto. Requer projeto no Google Cloud com "Custom Search API" ativada
# e um mecanismo em https://programmablesearchengine.google.com/ com
# "Busca de imagens" ativada.
# Desde março/2026 o Google descontinuou "Pesquisar toda a Web" para
# mecanismos novos - configure até 50 domínios específicos em
# "Recursos de pesquisa" > "Sites para pesquisar" (ex: farmácias,
# distribuidoras e marketplaces), usando o formato dominio.com.br/*.
# Faturamento só é necessário pra passar das 100 consultas grátis/dia;
# acima disso, ~US$5 a cada 1000 consultas.
VITE_GOOGLE_CSE_KEY=
VITE_GOOGLE_CSE_CX=

# Copie este arquivo para .env e preencha com as suas chaves.
# Sem nenhuma chave configurada, o app pula direto para a busca manual.
